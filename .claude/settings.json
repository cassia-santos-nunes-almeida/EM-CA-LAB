{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash C:/Users/cassi/Documents/GitHub/my-claude-skills/scripts/sync-to-projects.sh EM-CA-LAB 2>&1 || echo '[SYNC WARNING] Skill sync failed or timed out. Skills may be outdated. Run manually: bash C:/Users/cassi/Documents/GitHub/my-claude-skills/scripts/sync-to-projects.sh EM-CA-LAB'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash C:/Users/cassi/Documents/GitHub/my-claude-skills/scripts/check-skill-edit.sh",
            "if": "Write(.claude/skill/**)|Edit(.claude/skill/**)"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash C:/Users/cassi/Documents/GitHub/my-claude-skills/scripts/validate-structured-file.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "mcp__claude_ai_Notion__notion-search",
      "mcp__claude_ai_Notion__notion-fetch",
      "mcp__claude_ai_Notion__notion-create-pages",
      "mcp__claude_ai_Consensus__search",
      "mcp__claude_ai_Scholar_Gateway__semanticSearch",
      "mcp__claude_ai_academic-research-mcp__*"
    ]
  }
}
